# Public URL of the worker running on your laptop (e.g. a Cloudflare quick tunnel)
WORKER_URL=https://your-tunnel.trycloudflare.com
# Must match WORKER_SECRET in worker/.env
WORKER_SECRET=change-me
# Passcode to open /studio (leave empty to disable the gate - not recommended)
APP_PASSCODE=choose-a-passcode
# Hosts allowed when the worker URL is changed from the Studio settings (regex)
WORKER_URL_ALLOW=^https://[a-z0-9-]+\.trycloudflare\.com$
