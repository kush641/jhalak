# --- Sarvam (one key covers Saaras v4, Bulbul v4, Sarvam-105B and Token Factory)
SARVAM_API_KEY=
# Token Factory (OpenAI-compatible). Leave the key empty to reuse SARVAM_API_KEY.
TOKEN_FACTORY_BASE_URL=https://api.sarvam.ai/v2
TOKEN_FACTORY_API_KEY=
VISION_MODEL=gemma4
SCRIPT_MODEL=sarvam-105b
STT_MODEL=saaras:v4
TTS_MODEL=bulbul:v4-flash
DEFAULT_NARRATOR=shubh_hi_stories_dramatic

# --- Google Drive (folders shared as "anyone with the link")
GOOGLE_API_KEY=

# --- Worker
# Must match WORKER_SECRET in the Vercel project
WORKER_SECRET=change-me
DATA_DIR=./data
MAX_PARALLEL_CALLS=4
CHUNK_MAX_SECONDS=25
FRAMES_PER_CHUNK=8
SEPARATION=demucs
# Set to 1 to run without any API keys (fake transcripts, scripts and voice)
MOCK_APIS=0
